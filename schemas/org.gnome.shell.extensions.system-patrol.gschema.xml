<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.system-patrol.mascot">
    <value nick="cat" value="0"/>
    <value nick="raccoon" value="1"/>
  </enum>
  <enum id="org.gnome.shell.extensions.system-patrol.panelmode">
    <value nick="greeting" value="0"/>
    <value nick="activity" value="1"/>
    <value nick="stats" value="2"/>
    <value nick="custom" value="3"/>
  </enum>
  <schema id="org.gnome.shell.extensions.system-patrol"
          path="/org/gnome/shell/extensions/system-patrol/">
    <key name="mascot" enum="org.gnome.shell.extensions.system-patrol.mascot">
      <default>'cat'</default>
      <summary>HUD mascot</summary>
      <description>Which animal runs in the HUD.</description>
    </key>
    <key name="panel-mode" enum="org.gnome.shell.extensions.system-patrol.panelmode">
      <default>'greeting'</default>
      <summary>Top bar content</summary>
      <description>Greetings, a line tied to system load, plain CPU/RAM figures, or your own text.</description>
    </key>
    <key name="panel-custom-text" type="s">
      <default>'🐇 TuTzuOS · {cpu}%'</default>
      <summary>Custom top bar text</summary>
      <description>Placeholders: {cpu} {ram} {mascot} {host}</description>
    </key>
    <key name="show-public-ip" type="b">
      <default>true</default>
      <summary>Show public IP</summary>
      <description>Fetches the public address from api.ipify.org. This is the only part of the HUD that leaves the machine.</description>
    </key>
    <key name="glass-tint" type="i">
      <range min="0" max="100"/>
      <default>38</default>
      <summary>Glass tint</summary>
      <description>How strong the dark tint behind the HUD is, in percent. Lower is clearer glass.</description>
    </key>
    <key name="glass-blur" type="i">
      <range min="0" max="100"/>
      <default>40</default>
      <summary>Glass blur</summary>
      <description>How much the desktop behind the HUD is blurred. 0 turns the blur off.</description>
    </key>
    <key name="glass-brightness" type="i">
      <range min="0" max="100"/>
      <default>85</default>
      <summary>Glass brightness</summary>
      <description>Brightness of the blurred backdrop, in percent.</description>
    </key>
  </schema>
</schemalist>
